# Server identity (1, 2, or 3) — must be unique per FastAPI instance
SERVER_ID=1

# Postgres (single instance)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=q
POSTGRES_USER=q
POSTGRES_PASSWORD=q

# Redis nodes (comma-separated host:port pairs, order matters for consistent hashing)
REDIS_NODES=redis_1:6379,redis_2:6379
